{
  "name": "superclean",
  "version": "0.1.0",
  "description": "Clean out node_modules, build output, Expo ios/android folders, Next.js cache and Docker. Clean it all.",
  "keywords": ["cleanup", "node_modules", "disk-space", "expo", "nextjs", "docker", "cli"],
  "license": "Apache-2.0",
  "author": "Thomas Hagström",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/thomashagstrom/superclean.git"
  },
  "bin": {
    "superclean": "bin/superclean.sh"
  },
  "files": ["bin"],
  "os": ["darwin", "linux"],
  "scripts": {
    "clean": "bash bin/superclean.sh",
    "clean:yes": "bash bin/superclean.sh --yes",
    "clean:docker": "bash bin/superclean.sh --docker",
    "clean:all": "bash bin/superclean.sh --docker --yes",
    "test": "bash test/superclean.test.sh"
  }
}
